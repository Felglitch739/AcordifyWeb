type StrumDirection = 'down' | 'up' | 'mute' | 'rest'

interface StrumBeat {
  beat: number           // position in bar: 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5
  direction: StrumDirection
  accent: boolean        // true = stronger hit, visual emphasis
  palmMute: boolean      // visual indicator only, shown as [PM]
}

interface StrumPattern {
  id: string
  mood: string           // matches Mood Chassis mood name exactly
  name: string           // human readable: "Swing Melancólico"
  timeSignature: '4/4' | '3/4'
  beatsPerBar: number
  beats: StrumBeat[]
  description: string    // shown in UI: "Énfasis en tiempos débiles"
  difficulty: 'básico' | 'intermedio' | 'avanzado'
}

interface StrumState {
  isPlaying: boolean
  currentBeat: number    // 0-indexed position in beats array
  currentBar: number     // bar count since start
  activeMood: string
  pattern: StrumPattern
}

